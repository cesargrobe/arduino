// Definição dos pinos
const int pinoBotao1 = 2;
const int pinoBotao2 = 3;
const int pinoLED = 13;

// Variáveis de estado
bool estadoLED = false;
int estadoBotaoAnterior1 = HIGH;
int estadoBotaoAnterior2 = HIGH;

void setup() {
  pinMode(pinoBotao1, INPUT_PULLUP);
  pinMode(pinoBotao2, INPUT_PULLUP);
  pinMode(pinoLED, OUTPUT);
  
  digitalWrite(pinoLED, estadoLED); // Inicia o LED desligado
}

void loop() {
  int estadoBotaoAtual1 = digitalRead(pinoBotao1);
  int estadoBotaoAtual2 = digitalRead(pinoBotao2);

  // Detecta se o Botão 1 FOI pressionado
  bool cliqueBotao1 = (estadoBotaoAnterior1 == HIGH && estadoBotaoAtual1 == LOW);
  
  // Detecta se o Botão 2 FOI pressionado
  bool cliqueBotao2 = (estadoBotaoAnterior2 == HIGH && estadoBotaoAtual2 == LOW);

  // Se QUALQUER UM dos dois botões foi pressionado (Operador Lógico OU: ||)
  if (cliqueBotao1 || cliqueBotao2) {
    estadoLED = !estadoLED;             // Inverte o estado do LED
    digitalWrite(pinoLED, estadoLED);   // Atualiza o pino do LED
    delay(50);                           // Debounce para evitar ruídos de contato
  }

  // Atualiza o estado anterior para a próxima leitura
  estadoBotaoAnterior1 = estadoBotaoAtual1;
  estadoBotaoAnterior2 = estadoBotaoAtual2;
}
